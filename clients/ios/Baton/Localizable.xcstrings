    "正在撤销服务器会话…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Revoking server session…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在撤销服务器会话…" } } } },
    "正在同步会话…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Syncing conversation…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在同步会话…" } } } },
