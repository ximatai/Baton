    "返回" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Back" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "返回" } } } },
    "需要相机权限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera access required" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要相机权限" } } } },
    "连接本地演示服务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to local demo service" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接本地演示服务" } } } },
    "正在思考…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Thinking…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在思考…" } } } },
    "智能体正在思考…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Agent is thinking…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能体正在思考…" } } } },
    "智能体正在回复…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Agent is responding…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能体正在回复…" } } } },
