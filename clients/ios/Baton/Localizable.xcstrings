{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "Baton" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baton" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baton" } } } },
    "何为 Baton" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What is Baton?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "何为 Baton" } } } },
    "使用 Baton" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Using Baton" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 Baton" } } } },
    "完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } } } },
    "会话已不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Conversation unavailable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会话已不可用" } } } },
    "此会话已不可用，请返回列表重新扫码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation is no longer available. Return to the list and scan again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此会话已不可用，请返回列表重新扫码。" } } } },
    "服务端已结束此对话。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The service has ended this conversation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务端已结束此对话。" } } } },
    "把网页的 Agent 对话带到手机上。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring your web Agent conversation to your phone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把网页的 Agent 对话带到手机上。" } } } },
    "在各种网站服务或应用中，都会看到与 Agent 对话的窗口；但用电脑打字并不总是最方便。有时我们需要用手机实现更灵活的交流，例如语音。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Many websites and apps now offer an Agent conversation, but typing on a computer is not always the easiest way to respond. A phone can be more flexible, especially for voice." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在各种网站服务或应用中，都会看到与 Agent 对话的窗口；但用电脑打字并不总是最方便。有时我们需要用手机实现更灵活的交流，例如语音。" } } } },
    "为每个 Agent 服务开发或安装一个独立 App，成本很高。Baton 定义了一组标准化协议：只要服务提供者接入协议并展示二维码，你就能用这一款 App 与不同的 Agent 服务交流。手机加入同一段对话后，消息会实时同步，网页原有功能不受影响。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Building or installing a separate app for every Agent service is costly. Baton defines a standard protocol: once a service adopts it and shows a QR code, one app can connect you to many Agent services. After your phone joins the same conversation, messages stay in sync while the web keeps its original capabilities." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为每个 Agent 服务开发或安装一个独立 App，成本很高。Baton 定义了一组标准化协议：只要服务提供者接入协议并展示二维码，你就能用这一款 App 与不同的 Agent 服务交流。手机加入同一段对话后，消息会实时同步，网页原有功能不受影响。" } } } },
    "需要输入时扫码加入当前对话：手机适合语音，网页继续保留完整工作区。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan to join when you need to respond: use your phone for voice while the web keeps its full workspace." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要输入时扫码加入当前对话：手机适合语音，网页继续保留完整工作区。" } } } },
    "使用方式" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How it works" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用方式" } } } },
    "网页显示 Baton 二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The web page shows a Baton QR code" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网页显示 Baton 二维码" } } } },
    "网页系统展示 Baton 接入二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The web system shows a Baton connection QR code" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网页系统展示 Baton 接入二维码" } } } },
    "用 Baton 扫码加入当前对话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan with Baton to join the conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用 Baton 扫码加入当前对话" } } } },
    "把网页中的对话，接到手机上继续说。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue your web conversation on your phone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把网页中的对话，接到手机上继续说。" } } } },
    "当电脑上的 Agent 对话不方便打字时，用 Baton 扫码加入同一段对话。你可以在手机上语音输入、修改文字并发送；网页仍保留原有的业务界面。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When typing in a web-based Agent conversation is inconvenient, scan with Baton to join the same conversation. Speak, edit the transcription, and send from your phone while the web app keeps its full workspace." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当电脑上的 Agent 对话不方便打字时，用 Baton 扫码加入同一段对话。你可以在手机上语音输入、修改文字并发送；网页仍保留原有的业务界面。" } } } },
    "如何开始" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Get started" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如何开始" } } } },
    "在网页打开一段 Agent 对话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open an Agent conversation on the web" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在网页打开一段 Agent 对话" } } } },
    "让网页显示 Baton 二维码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Have the web page show a Baton QR code." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让网页显示 Baton 二维码。" } } } },
    "在这里扫描二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan the QR code here" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这里扫描二维码" } } } },
    "经网页确认后，手机会加入当前对话。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After approval on the web, your phone joins the current conversation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "经网页确认后，手机会加入当前对话。" } } } },
    "用语音或文字继续交流" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue by voice or text" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用语音或文字继续交流" } } } },
    "发送的消息会回到同一段网页对话。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Messages you send return to that same web conversation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送的消息会回到同一段网页对话。" } } } },
    "Baton 的角色" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What Baton does" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baton 的角色" } } } },
    "Baton 不是浏览器镜像，也不替代你的业务系统。登录、权限、会话和 Agent 仍由原来的网页服务负责；Baton 只是一个随时可加入的手机端。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baton is not a browser mirror and doesn’t replace your business system. Your web service still owns sign-in, permissions, conversations, and the Agent. Baton is simply a phone client that can join when you need it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baton 不是浏览器镜像，也不替代你的业务系统。登录、权限、会话和 Agent 仍由原来的网页服务负责；Baton 只是一个随时可加入的手机端。" } } } },
    "请只扫描可信网页提供的二维码。若服务使用未加密连接，进入对话后会明确提示。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only scan QR codes from web pages you trust. Baton clearly flags an unencrypted connection after you enter a conversation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请只扫描可信网页提供的二维码。若服务使用未加密连接，进入对话后会明确提示。" } } } },
    "了解 Baton 与接入方式" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Learn about Baton and integration" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "了解 Baton 与接入方式" } } } },
    "已加入的会话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Joined conversations" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已加入的会话" } } } },
    "检查" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查" } } } },
    "结束" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束" } } } },
    "断开" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "断开" } } } },
    "取消" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "断开本机访问？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect this device?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "断开本机访问？" } } } },
    "结束这段对话？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End this conversation?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束这段对话？" } } } },
    "结束对话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束对话" } } } },
    "扫码加入对话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Join a conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫码加入对话" } } } },
    "扫描网页上的 Baton 二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan a Baton QR code on the web" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描网页上的 Baton 二维码" } } } },
    "扫描二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan QR Code" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描二维码" } } } },
    "重新连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnect" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新连接" } } } },
    "断开本次会话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect this conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "断开本次会话" } } } },
    "结束当前对话？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End the current conversation?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束当前对话？" } } } },
    "所有已加入这段对话的设备都会退出。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All devices that joined this conversation will leave." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有已加入这段对话的设备都会退出。" } } } },
    "加入新会话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Join conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加入新会话" } } } },
    "未加密" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unencrypted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未加密" } } } },
    "未加密连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unencrypted connection" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未加密连接" } } } },
    "当前服务通过 HTTP 传输对话内容。在不可信网络中，内容可能被他人读取或篡改。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This service sends conversation content over HTTP. On an untrusted network, others may be able to read or alter it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前服务通过 HTTP 传输对话内容。在不可信网络中，内容可能被他人读取或篡改。" } } } },
    "请仅在可信网络中继续，或让服务提供方启用 HTTPS。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue only on a network you trust, or ask the service provider to enable HTTPS." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请仅在可信网络中继续，或让服务提供方启用 HTTPS。" } } } },
    "点按查看连接风险说明" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-tap for connection risk details" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点按查看连接风险说明" } } } },
    "重连" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnect" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重连" } } } },
    "重试" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } } } },
    "输入消息" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Message" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入消息" } } } },
    "知道了" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "知道了" } } } },
    "等待网页确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for web approval" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待网页确认" } } } },
    "正在自动接入" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Joining automatically" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在自动接入" } } } },
