    "正在创建本地 Pairing…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Creating local pairing…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在创建本地 Pairing…" } } } },
    "正在发现服务…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discovering service…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在发现服务…" } } } },
    "正在请求加入 %@…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Requesting access to %@…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在请求加入 %@…" } } } },
    "已连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接" } } } },
