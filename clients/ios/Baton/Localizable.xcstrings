    "连接已中断" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection interrupted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接已中断" } } } },
    "连接中断，正在重连…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection interrupted. Reconnecting…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接中断，正在重连…" } } } },
    "连接失败" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection failed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接失败" } } } },
    "对话已结束" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Conversation ended" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对话已结束" } } } },
    "会话恢复失败" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t restore conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会话恢复失败" } } } },
    "正在准备本地听写…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing on-device dictation…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备本地听写…" } } } },
    "正在下载本地语音模型…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading on-device speech model…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载本地语音模型…" } } } },
    "正在听写，松开即可转写（音频不会离开此设备）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Listening. Release to transcribe. Audio stays on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在听写，松开即可转写（音频不会离开此设备）" } } } },
    "正在完成转写…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finishing transcription…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在完成转写…" } } } },
    "无法安全保存本次会话（Keychain 错误）。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t securely save this conversation (Keychain error)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法安全保存本次会话（Keychain 错误）。" } } } },
    "Pairing URL 无效。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pairing URL is invalid." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Pairing URL 无效。" } } } },
    "服务地址必须是完整的 HTTP 或 HTTPS URL。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The service address must be a complete HTTP or HTTPS URL." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务地址必须是完整的 HTTP 或 HTTPS URL。" } } } },
    "服务端端点与 Pairing URL 不属于同一来源。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The server endpoint doesn’t share the pairing URL’s origin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务端端点与 Pairing URL 不属于同一来源。" } } } },
    "服务端响应格式无效。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The server response is invalid." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务端响应格式无效。" } } } },
    "停止生成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop generating" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止生成" } } } },
    "发送" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Send" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送" } } } },
    "可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Available" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用" } } } },
    "当前不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Currently unavailable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前不可用" } } } },
    "正在检查可用性" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking availability" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查可用性" } } } },
    "开始这段对话" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start this conversation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始这段对话" } } } },
    "输入文字，或使用麦克风在本地转写后发送。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type a message, or use the microphone to transcribe it on this device before sending." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入文字，或使用麦克风在本地转写后发送。" } } } },
    "当前服务使用未加密 HTTP 连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current service uses an unencrypted HTTP connection" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前服务使用未加密 HTTP 连接" } } } },
    "开始语音输入" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start voice input" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始语音输入" } } } },
    "结束语音输入" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop voice input" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束语音输入" } } } },
    "长按开始本地语音输入，松开后可编辑转写结果" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Touch and hold to start on-device voice input. Release to edit the transcription." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长按开始本地语音输入，松开后可编辑转写结果" } } } },
    "将网页上的 Baton Pairing 二维码放入取景框" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Place the Baton pairing QR code from the web page inside the frame" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将网页上的 Baton Pairing 二维码放入取景框" } } } },
    "未获得相机权限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera access not granted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未获得相机权限" } } } },
    "请在“设置 > Baton > 相机”中允许访问后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow camera access in Settings > Baton > Camera, then try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“设置 > Baton > 相机”中允许访问后重试。" } } } },
    "打开设置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开设置" } } } },
    "相机访问受限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera access restricted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机访问受限" } } } },
    "此设备的相机访问被系统或屏幕使用时间限制。请在系统设置中允许相机后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera access is restricted by the system or Screen Time. Allow it in Settings, then try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备的相机访问被系统或屏幕使用时间限制。请在系统设置中允许相机后重试。" } } } },
    "当前环境不能扫码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scanning unavailable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前环境不能扫码" } } } },
    "模拟器或无相机设备不能扫描二维码。请在真机上继续。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A simulator or device without a camera can’t scan QR codes. Continue on a physical device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模拟器或无相机设备不能扫描二维码。请在真机上继续。" } } } },
    "正在请求权限…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Requesting permission…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在请求权限…" } } } },
    "Baton 只使用相机读取网页展示的配对二维码。扫码不会自动授权加入会话。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baton uses the camera only to read pairing QR codes shown on web pages. Scanning never authorizes access automatically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baton 只使用相机读取网页展示的配对二维码。扫码不会自动授权加入会话。" } } } },
    "请在浏览器中确认这台设备的加入请求。确认前不会保存会话凭据。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm this device’s request in the browser. Baton won’t save a conversation credential before approval." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在浏览器中确认这台设备的加入请求。确认前不会保存会话凭据。" } } } },
    "此服务已为当前二维码开启自动批准。会话凭据仍只会在服务端签发后保存。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This service enabled automatic approval for this QR code. Baton still saves the conversation credential only after the server issues it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此服务已为当前二维码开启自动批准。会话凭据仍只会在服务端签发后保存。" } } } },
    "需要允许麦克风和语音识别权限，才能使用本地听写。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow microphone and speech recognition access to use on-device dictation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要允许麦克风和语音识别权限，才能使用本地听写。" } } } },
    "此设备当前不支持本地语音转文字。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device doesn’t currently support on-device speech-to-text." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备当前不支持本地语音转文字。" } } } },
    "此麦克风的音频格式不支持本地语音转文字。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This microphone’s audio format doesn’t support on-device speech-to-text." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此麦克风的音频格式不支持本地语音转文字。" } } } },
    "无法将此麦克风的音频转换为本地听写格式。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t convert this microphone’s audio to an on-device dictation format." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法将此麦克风的音频转换为本地听写格式。" } } } },
    "当前语言的本地语音模型不可用或下载失败。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The on-device speech model for the current language is unavailable or couldn’t be downloaded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前语言的本地语音模型不可用或下载失败。" } } } },
    "Baton 不会自行授予访问权限；是否需要网页确认由服务端决定。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baton never grants access by itself. The service decides whether web approval is required." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baton 不会自行授予访问权限；是否需要网页确认由服务端决定。" } } } },
    "已取消等待网页确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped waiting for web approval" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已取消等待网页确认" } } } },
    "消息未能安全暂存，请重新输入。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The message couldn’t be securely queued. Please enter it again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "消息未能安全暂存，请重新输入。" } } } },
    "该会话已不在本机保存列表中。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation is no longer saved on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该会话已不在本机保存列表中。" } } } },
    "请重新扫描网页中的二维码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan the QR code on the web page again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请重新扫描网页中的二维码。" } } } },
    "会话已失效，请重新扫码配对" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation is no longer valid. Scan to pair again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会话已失效，请重新扫码配对" } } } },
    "二维码配对已过期，请重新扫码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This pairing QR code has expired. Scan again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "二维码配对已过期，请重新扫码。" } } } },
    "此设备无法领取该配对凭据，请重新扫码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device can’t claim the pairing credential. Scan again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备无法领取该配对凭据，请重新扫码。" } } } },
    "远端撤销失败；本机会话仍保留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remote revocation failed; this device’s conversation is still saved" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "远端撤销失败；本机会话仍保留" } } } },
    "消息已安全暂存，将在下次连接时以原始请求重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The message was securely queued and will retry with its original request next time you connect." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "消息已安全暂存，将在下次连接时以原始请求重试。" } } } },
    "等待网页确认时连接中断" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection interrupted while waiting for web approval" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待网页确认时连接中断" } } } },
    "当前语言（%@）没有可用的本地语音模型。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No on-device speech model is available for %@." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前语言（%@）没有可用的本地语音模型。" } } } }
  },
  "version" : "1.0"
}
