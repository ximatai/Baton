    "打开网页确认页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open approval page" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开网页确认页" } } } },
